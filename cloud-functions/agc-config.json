{
  "projectId": "${AGC_PROJECT_ID}",
  "region": "cn-north-4",
  "functions": [
    {
      "name": "additive-interaction",
      "handler": "index.handler",
      "runtime": "Node.js16.17",
      "memory": 256,
      "timeout": 10,
      "triggers": [{ "type": "http", "path": "/api/additive-interaction" }]
    },
    {
      "name": "allergen-detect",
      "handler": "index.handler",
      "runtime": "Node.js16.17",
      "memory": 256,
      "timeout": 10,
      "triggers": [{ "type": "http", "path": "/api/allergen-detect" }]
    },
    {
      "name": "health-report-generator",
      "handler": "index.handler",
      "runtime": "Node.js16.17",
      "memory": 512,
      "timeout": 30,
      "triggers": [{ "type": "http", "path": "/api/health-report" }]
    },
    {
      "name": "user-data-deletion",
      "handler": "index.handler",
      "runtime": "Node.js16.17",
      "memory": 256,
      "timeout": 15,
