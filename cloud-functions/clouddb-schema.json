{
  "version": "1.0.0",
  "description": "家庭食品适配助手 CloudDB Schema",
  "collections": {
    "FamilyProfile": {
      "fields": {
        "memberId": { "type": "string", "primaryKey": true },
        "nickname": { "type": "string" },
        "ageGroup": { "type": "string" },
        "gender": { "type": "string" },
        "allergens": { "type": "array", "items": "string" },
        "healthGoals": { "type": "array", "items": "string" },
        "dailyBudget": { "type": "object" },
        "memberStatus": { "type": "object" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "indexes": [{ "fields": ["memberId"], "unique": true }]
    },
    "HealthSignal": {
      "fields": {
        "memberId": { "type": "string" },
        "stepLevel": { "type": "string" },
        "sleepStatus": { "type": "string" },
        "weightTrend": { "type": "string" },
        "manualBpStatus": { "type": "string" },
        "manualBsStatus": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "indexes": [{ "fields": ["memberId"], "unique": true }]
    },
    "DietRecord": {
      "fields": {
        "recordId": { "type": "string", "primaryKey": true },
        "memberId": { "type": "string" },
        "date": { "type": "string" },
        "foodName": { "type": "string" },
        "scenario": { "type": "string" },
        "amountG": { "type": "number" },
        "sodiumIntake": { "type": "number" },
        "sugarIntake": { "type": "number" },
        "calorieIntake": { "type": "number" },
        "fatIntake": { "type": "number" },
        "mealType": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "indexes": [{ "fields": ["memberId", "date"] }]
    },
    "ScanHistory": {
      "fields": {
        "scanId": { "type": "string", "primaryKey": true },
        "memberId": { "type": "string" },
        "barcode": { "type": "string" },
        "foodName": { "type": "string" },
        "nutriScore": { "type": "number" },
        "scannedAt": { "type": "number" }
      },
      "indexes": [{ "fields": ["memberId", "scannedAt"] }]
    },
    "ChatHistory": {
      "fields": {
        "chatId": { "type": "string", "primaryKey": true },
        "memberId": { "type": "string" },
        "messages": { "type": "array" },
        "createdAt": { "type": "number" }
      },
      "indexes": [{ "fields": ["memberId"] }]
    },
    "ShoppingList": {
      "fields": {
        "itemId": { "type": "string", "primaryKey": true },
        "memberId": { "type": "string" },
        "foodName": { "type": "string" },
        "barcode": { "type": "string" },
        "quantity": { "type": "number" },
        "checked": { "type": "boolean" },
        "addedAt": { "type": "number" }
      },
      "indexes": [{ "fields": ["memberId"] }]
    },
    "NutritionTarget": {
      "fields": {
        "memberId": { "type": "string" },
        "sodium_max_mg": { "type": "number" },
        "sugar_max_g": { "type": "number" },
        "calories_target": { "type": "number" },
        "fat_max_g": { "type": "number" },
        "protein_target_g": { "type": "number" },
        "fiber_min_g": { "type": "number" },
        "preset_name": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "indexes": [{ "fields": ["memberId"], "unique": true }]
    },
    "DailyBudget": {
      "fields": {
        "memberId": { "type": "string" },
        "date": { "type": "string" },
        "sodium_budget": { "type": "number" },
        "sugar_budget": { "type": "number" },
        "calorie_budget": { "type": "number" },
        "fat_budget": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "indexes": [{ "fields": ["memberId", "date"], "unique": true }]
    },
    "NutritionSnapshot": {
      "fields": {
        "snapshotId": { "type": "string", "primaryKey": true },
        "memberId": { "type": "string" },
        "date": { "type": "string" },
        "sodiumIntake": { "type": "number" },
        "sugarIntake": { "type": "number" },
        "calorieIntake": { "type": "number" },
        "fatIntake": { "type": "number" },
        "proteinIntake": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "indexes": [{ "fields": ["memberId", "date"] }]
    },
    "Favorite": {
      "fields": {
        "foodId": { "type": "string", "primaryKey": true },
        "memberId": { "type": "string" },
        "foodName": { "type": "string" },
        "barcode": { "type": "string" },
        "brand": { "type": "string" },
        "imageUrl": { "type": "string" },
        "nutriGrade": { "type": "string" },
        "source": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "indexes": [{ "fields": ["memberId"] }]
    },
    "ReminderRule": {
      "fields": {
        "ruleId": { "type": "string", "primaryKey": true },
        "memberId": { "type": "string" },
        "type": { "type": "string" },
        "enabled": { "type": "boolean" },
        "time": { "type": "string" },
        "conditions": { "type": "object" },
        "createdAt": { "type": "number" }
      },
      "indexes": [{ "fields": ["memberId"] }]
    },
    "FeedbackTicket": {
      "fields": {
        "ticketId": { "type": "string", "primaryKey": true },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "contact": { "type": "string" },
        "appVersion": { "type": "string" },
        "deviceModel": { "type": "string" },
        "osVersion": { "type": "string" },
        "screenshots": { "type": "array", "items": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "indexes": [{ "fields": ["userId", "status"] }, { "fields": ["createdAt"] }]
    },
    "PushToken": {
      "fields": {
        "tokenRecordId": { "type": "string", "primaryKey": true },
        "bundleName": { "type": "string" },
        "pushToken": { "type": "string" },
        "platform": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "indexes": [{ "fields": ["bundleName", "userId"], "unique": true }, { "fields": ["pushToken"] }]
    },
    "PushSubscription": {
      "fields": {
        "userId": { "type": "string", "primaryKey": true },
        "pushToken": { "type": "string" },
        "foodSafetyAlert": { "type": "boolean" },
        "additiveRisk": { "type": "boolean" },
        "nutritionTip": { "type": "boolean" },
        "productUpdate": { "type": "boolean" },
        "quietHoursStart": { "type": "string" },
        "quietHoursEnd": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "indexes": [{ "fields": ["userId"], "unique": true }]
    },
    "FoodSafetyAlert": {
      "fields": {
        "alertId": { "type": "string", "primaryKey": true },
        "alertType": { "type": "string" },
        "productName": { "type": "string" },
        "brand": { "type": "string" },
        "barcode": { "type": "string" },
        "reason": { "type": "string" },
        "actionRequired": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "region": { "type": "string" },
        "issuedAt": { "type": "number" },
        "notifiedCount": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "indexes": [{ "fields": ["alertType", "issuedAt"] }, { "fields": ["barcode"] }]
    },
    "FoodSubmission": {
      "fields": {
        "submissionId": { "type": "string", "primaryKey": true },
        "foodName": { "type": "string" },
        "barcode": { "type": "string" },
        "brand": { "type": "string" },
        "ingredients": { "type": "string" },
        "nutritionPer100g": { "type": "object" },
        "allergenHints": { "type": "array", "items": "string" },
        "submittedBy": { "type": "string" },
        "imageUrls": { "type": "array", "items": "string" },
        "status": { "type": "string" },
        "reviewer": { "type": "string" },
        "reviewComment": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "indexes": [{ "fields": ["submittedBy"] }, { "fields": ["barcode"] }, { "fields": ["status"] }]
    }
  }
}
