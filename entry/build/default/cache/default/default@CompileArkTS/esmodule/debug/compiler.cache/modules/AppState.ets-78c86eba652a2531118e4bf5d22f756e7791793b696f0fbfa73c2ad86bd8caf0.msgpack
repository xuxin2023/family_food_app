    async saveMember(profile) {
        await this.familyRepo.saveMember(profile);
        // æ›´æ–°ç¼“å­˜
        const index = this.membersCache.findIndex(m => m.memberId === profile.memberId);
        if (index >= 0) {
            this.membersCache[index] = profile;
