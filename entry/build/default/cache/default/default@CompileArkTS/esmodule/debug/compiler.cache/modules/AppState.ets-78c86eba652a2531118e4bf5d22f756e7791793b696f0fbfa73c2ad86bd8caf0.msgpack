  private dailyBudgetsCache: Map<string, DailyBudget> = new Map();
  private isInitialized: boolean = false;

  // è´­ç‰©ç¯®ï¼ˆå†…å­˜ä¸­æš‚å­˜ï¼‰
  private basketItems: FoodLabel[] = [];

  // è®¢é˜…çŠ¶æ€
