          Text(this.balance.nextMealAdvice)
            .fontSize(14)
            .fontColor('#212121')
        }
        .alignItems(HorizontalAlign.Start)
        .layoutWeight(1)
      }
      .margin({ bottom: 12 })

      // ä¸å†å åŠ 
      if (this.balance.avoidStacking.length > 0) {
        Row() {
          Text('ğŸš«').fontSize(14).margin({ right: 6 })
          Column() {
            Text('ä»Šå¤©ä¸å†å åŠ ').fontSize(13).fontColor('#757575').margin({ bottom: 2 })
            Text(this.balance.avoidStacking.join('ã€'))
              .fontSize(14)
              .fontColor('#FF5722')
          }
          .alignItems(HorizontalAlign.Start)
          .layoutWeight(1)
        }
        .margin({ bottom: 12 })
      }

      // è¡¥æ°´æé†’
      if (this.balance.hydrationReminder) {
        Row() {
          Text('ğŸ’§').fontSize(16).margin({ right: 6 })
          Text('æ³¨æ„è¡¥æ°´ï¼Œé¿å…ç”¨å«ç³–é¥®æ–™ä»£æ›¿æ°´')
            .fontSize(14)
            .fontColor('#1976D2')
        }
        .margin({ bottom: 8 })
      }

      // æˆå‘˜ç‰¹å®šå»ºè®®
      if (this.balance.memberSpecificAdvice.length > 0) {
        Divider().margin({ bottom: 8 })
        Text('é’ˆå¯¹æ‚¨çš„å»ºè®®ï¼š').fontSize(13).fontColor('#757575').margin({ bottom: 4 })
        Text(this.balance.memberSpecificAdvice)
          .fontSize(14)
          .fontColor('#212121')
