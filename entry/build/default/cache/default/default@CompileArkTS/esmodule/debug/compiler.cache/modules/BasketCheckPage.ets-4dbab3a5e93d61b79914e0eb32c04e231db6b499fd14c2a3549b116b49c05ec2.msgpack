import { router } from '@kit.ArkUI';
import { FoodLabel, FoodSource, NutritionPer100g } from '../model/FoodLabel';
import { BasketCheckResult } from '../engine/BasketCheckEngine';
import { AppState } from '../AppState';

@Entry
@Component
struct BasketCheckPage {
  @State basketItems: FoodLabel[] = []
  @State checkResult: BasketCheckResult | null = null

  private appState: AppState = AppState.getInstance()

  async aboutToAppear() {
    // ä»AppStateè·å–è´­ç‰©ç¯®æ•°æ®
    this.basketItems = this.appState.getBasketItems()
    if (this.basketItems.length === 0) {
      // æ— æ•°æ®æ—¶ä½¿ç”¨ç¤ºä¾‹
      this.basketItems = this.createFallbackBasket()
    }
    this.checkResult = this.appState.checkBasket()
  }

  build() {
    Scroll() {
      Column() {
        // é¡¶éƒ¨å¯¼èˆª
        Row() {
          Text('â†').fontSize(24).fontColor('#1976D2')
            .onClick(() => { router.back() })
          Text('è´­ç‰©ç¯®æ£€æŸ¥').fontSize(20).fontWeight(FontWeight.Bold)
            .margin({ left: 16 })
        }
        .width('100%')
        .padding({ left: 16, right: 16, top: 16, bottom: 16 })

        // ç¯®å­æ¦‚è§ˆ
        Row() {
          Text(`ğŸ›’ ${this.basketItems.length}æ¬¾é£Ÿå“`).fontSize(16).fontWeight(FontWeight.Medium)
          Blank()
          if (this.checkResult && this.checkResult.hasRisk()) {
            Text('éœ€è¦æ³¨æ„').fontSize(14).fontColor('#FF5722').fontWeight(FontWeight.Medium)
          } else {
            Text('æ•´ä½“å°šå¯').fontSize(14).fontColor('#4CAF50')
          }
        }
        .width('100%')
        .padding({ left: 16, right: 16 })
        .margin({ bottom: 12 })

        // è­¦å‘Šåˆ—è¡¨
        if (this.checkResult && this.checkResult.warnings.length > 0) {
          Column() {
            Text('âš  è´­ç‰©ç¯®æé†’').fontSize(16).fontWeight(FontWeight.Medium).margin({ bottom: 8 })
            ForEach(this.checkResult.warnings, (warning: string) => {
              Row() {
                Text('â€¢').fontSize(14).fontColor('#FF5722').margin({ right: 6 })
                Text(warning).fontSize(14).fontColor('#212121')
              }
              .margin({ bottom: 6 })
              .width('100%')
            }, (warning: string, index: number) => `${index}`)
          }
          .width('100%')
          .padding(16)
          .backgroundColor('#FFF3E0')
          .borderRadius(12)
          .margin({ left: 16, right: 16, bottom: 12 })
          .alignItems(HorizontalAlign.Start)
        }

        // é‡‡è´­å»ºè®®
        if (this.checkResult && this.checkResult.suggestions.length > 0) {
          Column() {
            Text('ğŸ’¡ é‡‡è´­å»ºè®®').fontSize(16).fontWeight(FontWeight.Medium).margin({ bottom: 8 })
            ForEach(this.checkResult.suggestions, (suggestion: string) => {
              Row() {
                Text('â€¢').fontSize(14).fontColor('#4CAF50').margin({ right: 6 })
                Text(suggestion).fontSize(14).fontColor('#212121')
              }
              .margin({ bottom: 6 })
              .width('100%')
            }, (suggestion: string, index: number) => `${index}`)
          }
          .width('100%')
          .padding(16)
          .backgroundColor('#E8F5E9')
          .borderRadius(12)
          .margin({ left: 16, right: 16, bottom: 12 })
          .alignItems(HorizontalAlign.Start)
        }

        // é£Ÿå“åˆ—è¡¨
        Text('ç¯®å†…é£Ÿå“').fontSize(14).fontColor('#757575')
          .margin({ left: 16, top: 8, bottom: 8 })

        ForEach(this.basketItems, (item: FoodLabel) => {
          Row() {
            Column() {
              Text(item.foodName).fontSize(14).fontWeight(FontWeight.Medium)
              Row() {
                if (item.isHighSodium()) { Text('é«˜ç›').fontSize(11).fontColor('#FFFFFF').backgroundColor('#FF5722').padding({ left: 6, right: 6, top: 2, bottom: 2 }).borderRadius(8).margin({ right: 4 }) }
                if (item.isHighSugar()) { Text('é«˜ç³–').fontSize(11).fontColor('#FFFFFF').backgroundColor('#FF9800').padding({ left: 6, right: 6, top: 2, bottom: 2 }).borderRadius(8).margin({ right: 4 }) }
                if (item.isHighFat()) { Text('é«˜è„‚').fontSize(11).fontColor('#FFFFFF').backgroundColor('#F44336').padding({ left: 6, right: 6, top: 2, bottom: 2 }).borderRadius(8) }
              }
              .margin({ top: 4 })
            }
            .alignItems(HorizontalAlign.Start)
            .layoutWeight(1)
          }
          .width('100%')
          .padding(12)
          .backgroundColor('#FFFFFF')
          .borderRadius(8)
          .margin({ left: 16, right: 16, bottom: 4 })
        }, (item: FoodLabel) => item.foodId)

        // ç»§ç»­æ‰«ææŒ‰é’®
        Button('ç»§ç»­æ‰«ææ·»åŠ ')
          .width('90%')
          .height(48)
          .backgroundColor('#1976D2')
          .borderRadius(24)
          .margin({ top: 16, bottom: 32 })
          .onClick(() => {
            router.pushUrl({ url: 'pages/ScanPage' })
          })
      }
      .width('100%')
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#FAFAFA')
    .scrollable(ScrollDirection.Vertical)
  }

  private createFallbackBasket(): FoodLabel[] {
    const items: FoodLabel[] = []
    const now = Date.now()

