import { CredibilityResult, DataGrade, RadarDimension, PublicQueryEntry } from '../model/CredibilityResult';

@Component
export struct CredibilityCard {
  @Prop result: CredibilityResult = new CredibilityResult();

  // é›·è¾¾å›¾5ä¸ªç»´åº¦åç§°
  private radarLabels: string[] = ['èº«ä»½æ¸…æ™°', 'è®¸å¯ä¿¡æ¯', 'è¿½æº¯å…¥å£', 'å…¬å¼€æŸ¥è¯¢', 'è¡¨è¾¾è¾¹ç•Œ'];

  build() {
    Column() {
      // æ ‡é¢˜è¡Œ + æ•°æ®ç­‰çº§
      Row() {
        Text('ç”Ÿäº§ä¸»ä½“ä¿¡æ¯')
          .fontSize(16)
          .fontWeight(FontWeight.Medium)
          .layoutWeight(1)

        // A-Eæ•°æ®ç­‰çº§æ ‡è¯†
        this.GradeBadge(this.result.overallGrade)
      }
      .width('100%')
      .margin({ bottom: 8 })

      // æ•°æ®ç­‰çº§è¯´æ˜
      Text(this.result.getGradeDesc())
        .fontSize(12)
        .fontColor('#757575')
        .margin({ bottom: 12 })

      // 5ç»´é›·è¾¾å›¾
      if (this.result.radarDimensions.length > 0) {
        this.RadarChart()
      } else {
        // é™çº§ï¼šæ—§ç‰ˆè¿›åº¦æ¡
        Row() {
          Text('é€æ˜åº¦').fontSize(12).fontColor('#757575').margin({ right: 4 })
          Text(`${this.result.score}`).fontSize(20).fontWeight(FontWeight.Bold)
            .fontColor(this.result.score >= 60 ? '#4CAF50' : '#FF5722')
        }
        .margin({ bottom: 4 })
        Progress({ value: this.result.score, total: 100, type: ProgressType.Linear })
          .width('100%')
          .color(this.result.score >= 60 ? '#4CAF50' : '#FF5722')
          .backgroundColor('#E0E0E0')
          .margin({ bottom: 12 })
      }

      // å„ç»´åº¦è¯¦æƒ…
      if (this.result.radarDimensions.length > 0) {
        ForEach(this.result.radarDimensions, (dim: RadarDimension) => {
          this.DimensionRow(dim)
        }, (dim: RadarDimension, index: number) => `${index}`)
      }

      // æç¤ºä¿¡æ¯åˆ—è¡¨
      if (this.result.tips.length > 0) {
        Column() {
          ForEach(this.result.tips, (tip: string) => {
            Row() {
              Text('â€¢').fontSize(12).fontColor('#757575').margin({ right: 6 })
              Text(tip).fontSize(12).fontColor('#616161')
            }
            .margin({ bottom: 4 })
            .width('100%')
          }, (tip: string, index: number) => `${index}`)
        }
        .margin({ top: 8 })
      }

      // å…¬å¼€æŸ¥è¯¢å…¥å£
      if (this.result.publicQueryEntries.length > 0) {
        this.PublicQuerySection()
      }
    }
    .width('100%')
    .padding(16)
    .backgroundColor('#FFFFFF')
    .borderRadius(12)
    .alignItems(HorizontalAlign.Start)
  }

  // A-Eæ•°æ®ç­‰çº§æ ‡è¯†
  @Builder
  GradeBadge(grade: DataGrade) {
    Row() {
      Text(grade)
        .fontSize(16)
        .fontWeight(FontWeight.Bold)
        .fontColor('#FFFFFF')
    }
    .width(28)
    .height(28)
    .borderRadius(14)
    .backgroundColor(this.getGradeColor(grade))
    .justifyContent(FlexAlign.Center)
    .alignItems(VerticalAlign.Center)
  }

  // é›·è¾¾å›¾ï¼ˆç”¨Canvasæ¨¡æ‹Ÿäº”è¾¹å½¢ï¼‰
  @Builder
  RadarChart() {
    Column() {
      // ä¸­å¿ƒè¯„åˆ†
      Text(`${this.result.score}`)
        .fontSize(32)
        .fontWeight(FontWeight.Bold)
        .fontColor(this.result.score >= 60 ? '#4CAF50' : '#FF5722')

      Text('ä¿¡æ¯é€æ˜åº¦')
        .fontSize(11)
        .fontColor('#757575')
        .margin({ top: 2, bottom: 8 })

      // 5ç»´æ¡å½¢å›¾ï¼ˆæ›¿ä»£Canvasé›·è¾¾å›¾ï¼ŒArkUI Canvasåœ¨ç»„ä»¶ä¸­å—é™ï¼‰
      ForEach(this.result.radarDimensions, (dim: RadarDimension, index: number) => {
        Row() {
          Text(this.radarLabels[index] || dim.name)
            .fontSize(11)
            .fontColor('#757575')
            .width(60)

          // è¿›åº¦æ¡è¡¨ç¤ºç»´åº¦å¾—åˆ†
          Progress({ value: this.getDimensionScore(dim), total: 100, type: ProgressType.Linear })
            .layoutWeight(1)
            .height(6)
            .color(this.getDimensionColor(dim))
            .backgroundColor('#E0E0E0')

          Text(dim.status)
            .fontSize(10)
            .fontColor(this.getDimensionColor(dim))
            .width(50)
            .textAlign(TextAlign.End)
        }
        .width('100%')
        .margin({ bottom: 6 })
        .alignItems(VerticalAlign.Center)
      }, (dim: RadarDimension, index: number) => `${index}`)
    }
    .width('100%')
    .padding({ top: 8, bottom: 8 })
    .alignItems(HorizontalAlign.Center)
  }

  // ç»´åº¦è¯¦æƒ…è¡Œ
  @Builder
  DimensionRow(dim: RadarDimension) {
    Row() {
      this.GradeBadge(dim.grade)
      Text(dim.name)
        .fontSize(13)
        .fontWeight(FontWeight.Medium)
        .margin({ left: 8 })
        .layoutWeight(1)
      Text(dim.status)
        .fontSize(12)
        .fontColor(this.getDimensionColor(dim))
    }
    .width('100%')
    .margin({ bottom: 4 })
    .alignItems(VerticalAlign.Center)
  }

  // å…¬å¼€æŸ¥è¯¢å…¥å£
  @Builder
  PublicQuerySection() {
    Column() {
      Text('å…¬å¼€æŸ¥è¯¢å…¥å£')
        .fontSize(14)
        .fontWeight(FontWeight.Medium)
        .margin({ top: 12, bottom: 8 })

      ForEach(this.result.publicQueryEntries, (entry: PublicQueryEntry) => {
        Row() {
          Column() {
            Text(entry.name).fontSize(13).fontWeight(FontWeight.Medium)
            Text(`æŸ¥è¯¢å…³é”®è¯ï¼š${entry.keyword}`)
              .fontSize(11)
              .fontColor('#757575')
              .margin({ top: 2 })
            Text(entry.description)
              .fontSize(11)
              .fontColor('#9E9E9E')
              .margin({ top: 2 })
          }
          .alignItems(HorizontalAlign.Start)
          .layoutWeight(1)

          Text('å¤åˆ¶')
            .fontSize(12)
            .fontColor('#1976D2')
            .padding({ left: 8, right: 8, top: 4, bottom: 4 })
            .borderRadius(8)
            .backgroundColor('#E3F2FD')
            .onClick(() => {
              // TODO: å¤åˆ¶åˆ°å‰ªè´´æ¿
            })
        }
        .width('100%')
        .padding(8)
        .backgroundColor('#F5F5F5')
        .borderRadius(8)
        .margin({ bottom: 6 })
        .alignItems(VerticalAlign.Center)
      }, (entry: PublicQueryEntry, index: number) => `${index}`)
    }
    .width('100%')
    .alignItems(HorizontalAlign.Start)
  }

  // è¾…åŠ©æ–¹æ³•
  private getGradeColor(grade: DataGrade): string {
    switch (grade) {
      case DataGrade.A: return '#4CAF50'  // ç»¿
      case DataGrade.B: return '#8BC34A'  // æµ…ç»¿
      case DataGrade.C: return '#FF9800'  // æ©™
      case DataGrade.D: return '#FF5722'  // æ·±æ©™
      case DataGrade.E: return '#9E9E9E'  // ç°
      default: return '#9E9E9E'
    }
  }

  private getDimensionScore(dim: RadarDimension): number {
    if (dim.status === 'æ¸…æ™°') return 90
    if (dim.status === 'éƒ¨åˆ†æ¸…æ™°') return 50
    if (dim.status === 'æœªè¯†åˆ«') return 10
    return 30
  }

  private getDimensionColor(dim: RadarDimension): string {
    return this.getGradeColor(dim.grade)
  }
}
