//# sourceMappingURL=FamilyCompareView.js.mapÂ’ÙBE:\APP\family_food_app\entry\src\main\ets\model\Recommendation.etsÙAE:\APP\family_food_app\entry\src\main\ets\model\FamilyProfile.etsÙJE:\APP\family_food_app\entry\src\main\ets\components\FamilyCompareView.etsÔrB›ªmoduleName±isLocalDependency¯isNodeEntryFile§pkgPath±belongProjectPath§pkgNameªpkgVersion±dependencyPkgInfo¯hostModulesInfo°belongModulePath¬shouldEmitJs¥entryÃÂ¼E:\APP\family_food_app\entry¶E:\APP\family_food_app¥entry¥1.0.0Ô␀␀‘ÔrC’²hostDependencyName®hostModuleName¿../components/FamilyCompareView¥entry¼E:\APP\family_food_app\entryÃÃÚ// å®¶åº­å¯¹æ¯”è§†å›¾ç»„ä»¶ - åŒä¸€é£Ÿå“å¯¹å…¨å®¶ä¸åŒå»ºè®®

import { Recommendation, RecommendLevel, LevelColor, getLevelColorValue } from '../model/Recommendation';
import { FamilyProfile } from '../model/FamilyProfile';

@Component
export struct FamilyCompareView {
  @Prop recommendations: Recommendation[] = [];
  @Prop members: FamilyProfile[] = [];

  build() {
    Column() {
      Text('ä¸€å®¶äººä¸åŒç»“è®º')
        .fontSize(16)
        .fontWeight(FontWeight.Medium)
        .fontColor('#212121')
        .margin({ bottom: 12 })

      // æ¨ªå‘å¯¹æ¯”å¡ç‰‡
      Scroll() {
        Row() {
          ForEach(this.recommendations, (rec: Recommendation, index: number) => {
            this.MemberCompareCard(rec, this.members[index] || new FamilyProfile())
          }, (rec: Recommendation) => rec.memberId)
        }
      }
      .scrollable(ScrollDirection.Horizontal)
      .width('100%')
    }
    .width('100%')
    .padding(16)
    .backgroundColor('#FFFFFF')
    .borderRadius(12)
    .alignItems(HorizontalAlign.Start)
  }

  @Builder
  MemberCompareCard(rec: Recommendation, member: FamilyProfile) {
    Column() {
      // æˆå‘˜emoji
      Text(this.getMemberEmoji(member))
        .fontSize(28)
        .margin({ bottom: 4 })

      // æ˜µç§°
      Text(member.nickname)
        .fontSize(13)
        .fontColor('#212121')
        .margin({ bottom: 6 })

      // ç­‰çº§æ ‡è¯†
      Text(rec.level)
        .fontSize(12)
        .fontColor('#FFFFFF')
        .padding({ left: 8, right: 8, top: 3, bottom: 3 })
        .borderRadius(10)
        .backgroundColor(getLevelColorValue(rec.levelColor))
        .margin({ bottom: 6 })

      // å¯åƒé‡
      if (rec.maxAmount > 0) {
        Text(`${rec.maxAmount}g`)
          .fontSize(18)
          .fontWeight(FontWeight.Bold)
          .fontColor('#212121')
      } else {
        Text('é¿å…')
          .fontSize(18)
          .fontWeight(FontWeight.Bold)
          .fontColor('#F44336')
      }

      // ç¬¬ä¸€æ¡åŸå› 
      if (rec.reasons.length > 0) {
        Text(rec.reasons[0])
          .fontSize(10)
          .fontColor('#757575')
          .maxLines(2)
          .textOverflow({ overflow: TextOverflow.Ellipsis })
          .margin({ top: 4 })
          .constraintSize({ maxWidth: 80 })
      }
    }
    .width(90)
    .padding({ top: 12, bottom: 12 })
    .margin({ right: 8 })
    .borderRadius(12)
    .backgroundColor('#F5F5F5')
    .alignItems(HorizontalAlign.Center)
  }

  private getMemberEmoji(member: FamilyProfile): string {
    if (member.nickname === 'çˆ¸çˆ¸') return 'ğŸ‘¨';
    if (member.nickname === 'å¦ˆå¦ˆ') return 'ğŸ‘©';
    if (member.nickname === 'å­©å­') return 'ğŸ‘¶';
    return 'ğŸ§‘';
  }
}
