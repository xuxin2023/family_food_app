import { FoodLabel } from '../model/FoodLabel';

@Component
export struct FoodLabelCard {
  @Prop foodLabel: FoodLabel = new FoodLabel();

  build() {
    Column() {
      // é£Ÿå“åç§°
      Text(this.foodLabel.foodName)
        .fontSize(18)
        .fontWeight(FontWeight.Bold)
        .fontColor('#212121')
        .margin({ bottom: 12 })

      // è¥å…»æˆåˆ†ç½‘æ ¼
      Text('è¥å…»æˆåˆ†ï¼ˆæ¯100gï¼‰').fontSize(13).fontColor('#757575').margin({ bottom: 6 })
      Grid() {
        GridItem() { this.NutritionItem('é’ ', `${this.foodLabel.nutrition.sodium}mg`, this.foodLabel.isHighSodium()) }
        GridItem() { this.NutritionItem('ç³–', `${this.foodLabel.nutrition.sugar}g`, this.foodLabel.isHighSugar()) }
        GridItem() { this.NutritionItem('çƒ­é‡', `${this.foodLabel.nutrition.calories}kcal`, this.foodLabel.isHighCalorie()) }
        GridItem() { this.NutritionItem('è„‚è‚ª', `${this.foodLabel.nutrition.fat}g`, this.foodLabel.isHighFat()) }
        GridItem() { this.NutritionItem('ç¢³æ°´', `${this.foodLabel.nutrition.carbohydrate}g`, false) }
        GridItem() { this.NutritionItem('è›‹ç™½è´¨', `${this.foodLabel.nutrition.protein}g`, false) }
      }
      .columnsTemplate('1fr 1fr 1fr')
      .rowsGap(6)
      .columnsGap(6)
      .width('100%')
      .margin({ bottom: 12 })

      // é…æ–™è¡¨
      if (this.foodLabel.ingredients.length > 0) {
        Text('é…æ–™').fontSize(13).fontColor('#757575').margin({ bottom: 4 })
        Text(this.foodLabel.ingredients.join('ã€'))
          .fontSize(12)
          .fontColor('#616161')
          .maxLines(3)
          .textOverflow({ overflow: TextOverflow.Ellipsis })
      }
    }
    .width('100%')
    .padding(16)
    .backgroundColor('#FFFFFF')
    .borderRadius(12)
    .alignItems(HorizontalAlign.Start)
  }

  @Builder
  NutritionItem(name: string, value: string, isHigh: boolean) {
    Column() {
      Text(name).fontSize(11).fontColor('#9E9E9E')
      Text(value)
        .fontSize(14)
        .fontWeight(FontWeight.Medium)
        .fontColor(isHigh ? '#FF5722' : '#212121')
        .margin({ top: 2 })
    }
    .padding(8)
    .backgroundColor(isHigh ? '#FFF3E0' : '#F5F5F5')
    .borderRadius(8)
    .alignItems(HorizontalAlign.Center)
  }
}
