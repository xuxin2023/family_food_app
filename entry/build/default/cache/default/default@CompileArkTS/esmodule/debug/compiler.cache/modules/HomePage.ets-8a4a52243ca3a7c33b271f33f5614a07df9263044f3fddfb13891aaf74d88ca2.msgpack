                onSelect: (id: string) => { this.selectedMemberId = id }
              })
            }
            .width('45%')
            .margin(8)
          }, (member: FamilyProfile) => member.memberId)

          // æ·»åŠ æˆå‘˜æŒ‰é’®ï¼ˆå¸¦é—¨æŽ§ï¼‰
          Column() {
            Text('+').fontSize(28).fontColor('#1976D2')
            Text(this.appState.canAddMember() ? 'æ·»åŠ æˆå‘˜' : 'å‡çº§è§£é”')
              .fontSize(12)
              .fontColor(this.appState.canAddMember() ? '#1976D2' : '#FF9800')
              .margin({ top: 4 })
          }
          .width('45%')
          .height(100)
          .margin(8)
          .borderRadius(16)
          .justifyContent(FlexAlign.Center)
          .alignItems(HorizontalAlign.Center)
          .border({ width: 1, color: '#E0E0E0', style: BorderStyle.Dashed, radius: 16 })
          .onClick(() => {
            if (this.appState.canAddMember()) {
              router.pushUrl({ url: 'pages/MemberEditPage' })
            } else {
              router.pushUrl({ url: 'pages/SettingsPage' })
            }
          })
        }
        .width('100%')
        .padding({ left: 16, right: 16 })
      }
      .scrollable(ScrollDirection.Vertical)
      .layoutWeight(1)

      // åº•éƒ¨æ“ä½œåŒº
      Column() {
        // æ‹é£Ÿå“æ ‡ç­¾æŒ‰é’®
        Button() {
          Row() {
            Text('ðŸ“·').fontSize(20)
            Text('æ‹é£Ÿå“æ ‡ç­¾').fontSize(18).fontColor('#FFFFFF').margin({ left: 8 })
          }
        }
        .width('90%')
        .height(56)
        .backgroundColor('#1976D2')
        .borderRadius(28)
        .margin({ bottom: 12 })
        .onClick(() => {
          router.pushUrl({
            url: 'pages/ScanPage',
            params: { memberId: this.selectedMemberId }
          })
        })

        // è®°å½•ç¾Žé£ŸæŒ‰é’®
        Button() {
          Row() {
            Text('ðŸ½').fontSize(20)
            Text('è®°å½•ç¾Žé£Ÿ').fontSize(18).fontColor('#1976D2').margin({ left: 8 })
          }
        }
        .width('90%')
        .height(56)
        .backgroundColor('#E3F2FD')
        .borderRadius(28)
        .margin({ bottom: 12 })
        .onClick(() => {
          router.pushUrl({
            url: 'pages/BalancePage',
            params: { memberId: this.selectedMemberId }
          })
        })

        // è´­ç‰©ç¯®æ£€æŸ¥å…¥å£ï¼ˆå®¶åº­æ—©é¸ŸåŠä»¥ä¸Šï¼‰
        if (this.appState.canAccess(SubscriptionTier.FAMILY_EARLY)) {
          Button() {
            Row() {
              Text('ðŸ›’').fontSize(20)
              Text('è´­ç‰©ç¯®æ£€æŸ¥').fontSize(18).fontColor('#FF9800').margin({ left: 8 })
            }
          }
          .width('90%')
          .height(48)
          .backgroundColor('#FFF3E0')
          .borderRadius(24)
          .margin({ bottom: 12 })
          .onClick(() => {
            router.pushUrl({ url: 'pages/BasketCheckPage' })
          })
        }

        // åº•éƒ¨å¿«æ·å…¥å£
        Row() {
          Text('åŽ†å²').fontSize(13).fontColor('#757575')
            .onClick(() => { router.pushUrl({ url: 'pages/HistoryPage' }) })
          Text('  |  ').fontSize(13).fontColor('#E0E0E0')
          if (this.appState.canAccess(SubscriptionTier.FAMILY_EARLY)) {
            Text('å‘¨æŠ¥').fontSize(13).fontColor('#757575')
              .onClick(() => { router.pushUrl({ url: 'pages/WeeklyReportPage' }) })
            Text('  |  ').fontSize(13).fontColor('#E0E0E0')
          }
          Text('è®¾ç½®').fontSize(13).fontColor('#757575')
            .onClick(() => { router.pushUrl({ url: 'pages/SettingsPage' }) })
        }
        .margin({ bottom: 16 })
      }
      .width('100%')
      .alignItems(HorizontalAlign.Center)
      .padding({ left: 16, right: 16 })
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#FAFAFA')
  }

}
