          .margin({ top: 20, bottom: 4 })

        Text(this.slogans[this.currentSloganIndex])
          .fontSize(14)
          .fontColor('#757575')
          .margin({ bottom: 16 })
          .textAlign(TextAlign.Center)
          .maxLines(2)
      }
      .width('100%')
      .alignItems(HorizontalAlign.Center)

      // V5å¢å¼ºï¼šä»Šæ—¥å®¶åº­çŠ¶æ€æ¡
      this.buildFamilyStatusBar()

      // å®¶åº­æˆå‘˜é€‰æ‹©
      Text('ä»Šå¤©ç»™è°çœ‹ï¼Ÿ')
        .fontSize(18)
        .fontWeight(FontWeight.Medium)
        .fontColor('#212121')
        .margin({ left: 16, bottom: 8 })

      Scroll() {
        Flex({ wrap: FlexWrap.Wrap, justifyContent: FlexAlign.Start, alignItems: ItemAlign.Start }) {
          ForEach(this.familyMembers, (member: FamilyProfile) => {
            Column() {
              MemberCard({
                member: member,
                isSelected: this.selectedMemberId === member.memberId,
                onSelect: (id: string) => { this.selectedMemberId = id }
              })
            }
            .width('45%')
            .margin(8)
          }, (member: FamilyProfile) => member.memberId)

          Column() {
            Text('+').fontSize(28).fontColor('#1976D2')
            Text(this.appState.canAddMember() ? 'æ·»åŠ æˆå‘˜' : 'å‡çº§è§£é”')
              .fontSize(12)
              .fontColor(this.appState.canAddMember() ? '#1976D2' : '#FF9800')
              .margin({ top: 4 })
          }
          .width('45%')
          .height(100)
          .margin(8)
          .borderRadius(16)
          .justifyContent(FlexAlign.Center)
          .alignItems(HorizontalAlign.Center)
          .border({ width: 1, color: '#E0E0E0', style: BorderStyle.Dashed, radius: 16 })
          .onClick(() => {
            if (this.appState.canAddMember()) {
              router.pushUrl({ url: 'pages/MemberEditPage' })
            } else {
              router.pushUrl({ url: 'pages/SettingsPage' })
            }
          })
        }
        .width('100%')
        .padding({ left: 16, right: 16 })
      }
      .scrollable(ScrollDirection.Vertical)
      .layoutWeight(1)

      // åº•éƒ¨æ“ä½œåŒº
      Column() {
        Button() {
          Row() {
            Text('ğŸ“·').fontSize(20)
            Text('æ‹é£Ÿå“æ ‡ç­¾').fontSize(18).fontColor('#FFFFFF').margin({ left: 8 })
          }
        }
        .width('90%')
        .height(56)
        .backgroundColor('#1976D2')
        .borderRadius(28)
        .margin({ bottom: 12 })
        .onClick(() => {
          router.pushUrl({
            url: 'pages/ScanPage',
            params: { memberId: this.selectedMemberId }
          })
        })

        Button() {
          Row() {
            Text('ğŸ½').fontSize(20)
            Text('è®°å½•ç¾é£Ÿ').fontSize(18).fontColor('#1976D2').margin({ left: 8 })
          }
        }
        .width('90%')
        .height(56)
        .backgroundColor('#E3F2FD')
        .borderRadius(28)
        .margin({ bottom: 12 })
        .onClick(() => {
          router.pushUrl({
            url: 'pages/BalancePage',
            params: { memberId: this.selectedMemberId }
          })
        })

        if (this.appState.canAccess(SubscriptionTier.FAMILY_EARLY)) {
          Button() {
            Row() {
              Text('ğŸ›’').fontSize(20)
              Text('è´­ç‰©ç¯®æ£€æŸ¥').fontSize(18).fontColor('#FF9800').margin({ left: 8 })
            }
          }
          .width('90%')
          .height(48)
          .backgroundColor('#FFF3E0')
          .borderRadius(24)
          .margin({ bottom: 12 })
          .onClick(() => {
            router.pushUrl({ url: 'pages/BasketCheckPage' })
          })
        }

        Row() {
          Text('å†å²').fontSize(13).fontColor('#757575')
            .onClick(() => { router.pushUrl({ url: 'pages/HistoryPage' }) })
          Text('  |  ').fontSize(13).fontColor('#E0E0E0')
          if (this.appState.canAccess(SubscriptionTier.FAMILY_EARLY)) {
            Text('å‘¨æŠ¥').fontSize(13).fontColor('#757575')
              .onClick(() => { router.pushUrl({ url: 'pages/WeeklyReportPage' }) })
            Text('  |  ').fontSize(13).fontColor('#E0E0E0')
          }
          Text('è®¾ç½®').fontSize(13).fontColor('#757575')
            .onClick(() => { router.pushUrl({ url: 'pages/SettingsPage' }) })
        }
        .margin({ bottom: 16 })
      }
      .width('100%')
      .alignItems(HorizontalAlign.Center)
      .padding({ left: 16, right: 16 })
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#FAFAFA')
  }

  @Builder
  buildFamilyStatusBar() {
    Column() {
      Row() {
        Text('ğŸ’¡')
          .fontSize(16)
          .margin({ right: 4 })
        Text('ä»Šæ—¥å®¶åº­çŠ¶æ€')
          .fontSize(14)
          .fontWeight(FontWeight.Medium)
          .fontColor('#1A1A1A')
        Blank()
        Text('ç‚¹å‡»åˆ·æ–°')
          .fontSize(11)
          .fontColor('#007DFF')
          .onClick(() => {
            this.refreshToggle = !this.refreshToggle
          })
      }
      .width('100%')
      .margin({ bottom: 8 })

      if (this.familyMembers.length > 0) {
        Flex({ wrap: FlexWrap.Wrap }) {
          ForEach(this.familyMembers, (member: FamilyProfile) => {
            this.buildMemberStatusItem(member)
          })
        }
        .width('100%')
      }
    }
    .width('100%')
    .padding(12)
    .backgroundColor('#FFFFFF')
    .borderRadius(10)
    .margin({ left: 16, right: 16, bottom: 12 })
    .shadow({ radius: 2, color: '#1A000000', offsetY: 1 })
  }

  @Builder
  buildMemberStatusItem(member: FamilyProfile) {
    Row() {
      Text(this.getMemberEmoji(member))
        .fontSize(14)
        .margin({ right: 4 })
      Text(member.nickname)
        .fontSize(12)
        .fontColor('#333333')
        .margin({ right: 4 })
      Text(this.getMemberStatusText(member))
        .fontSize(11)
        .fontColor(this.getMemberStatusColor(member))
    }
    .width('48%')
    .margin({ top: 4, bottom: 4 })
  }

  private getMemberEmoji(member: FamilyProfile): string {
    if (member.nickname === 'çˆ¸çˆ¸') return 'ğŸ‘¨'
    if (member.nickname === 'å¦ˆå¦ˆ') return 'ğŸ‘©'
    if (member.nickname === 'å­©å­') return 'ğŸ‘¶'
    return 'ğŸ§‘'
  }

  private getMemberStatusText(member: FamilyProfile): string {
    const goal = member.healthGoals[0]
    if (goal === 'æ§å‹') return 'é«˜ç›é¢åº¦å‰©ä½™85%'
    if (goal === 'æ§ç³–') return 'ç³–é¢„ç®—å‰©ä½™70%'
    if (goal === 'å‡è„‚') return 'çƒ­é‡é¢„ç®—å‰©ä½™60%'
    if (goal === 'å„¿ç«¥') return 'ä»Šæ—¥é›¶é£Ÿ0æ¬¡/å»ºè®®â‰¤3æ¬¡'
    return 'é¢„ç®—å……è¶³'
  }

  private getMemberStatusColor(member: FamilyProfile): string {
    const goal = member.healthGoals[0]
    if (goal === 'æ§å‹') return '#EF7D00'
    if (goal === 'æ§ç³–') return '#00823F'
    if (goal === 'å‡è„‚') return '#007DFF'
    if (goal === 'å„¿ç«¥') return '#9C27B0'
    return '#00823F'
  }
}
