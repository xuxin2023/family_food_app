// 美食平衡场景模板配置 - 本地JSON格式，每种场景提供完整建议

export interface MealTemplate {
  /** 场景名称 */
  scenario: string;
  /** 本餐偏高风险标签 */
  riskTags: string[];
  /** 下一餐建议（具体菜品） */
  nextMealAdvice: string;
  /** 今天不再叠加的品类 */
  avoidStacking: string[];
  /** 是否需要补水提醒 */
  hydrationReminder: boolean;
  /** 明天早餐建议 */
  morningAdvice: string;
  /** 下一餐重点补充的营养素 */
  nextMealNutrients: string[];
  /** 各健康目标的特定建议 */
  goalAdvice: Record<string, string>;
}

