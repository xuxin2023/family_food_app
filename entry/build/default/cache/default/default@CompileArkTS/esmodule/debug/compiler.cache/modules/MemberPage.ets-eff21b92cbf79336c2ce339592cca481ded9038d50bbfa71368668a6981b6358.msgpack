import { router } from '@kit.ArkUI';
import { FamilyProfile } from '../model/FamilyProfile';

@Entry
@Component
struct MemberPage {
  @State members: FamilyProfile[] = []

  aboutToAppear() {
    // TODO: ä»Žæœ¬åœ°æ•°æ®åº“åŠ è½½
  }

  build() {
    Column() {
      // é¡¶éƒ¨å¯¼èˆª
      Row() {
        Text('â†').fontSize(24).fontColor('#1976D2')
          .onClick(() => { router.back() })
        Text('å®¶åº­æˆå‘˜ç®¡ç†').fontSize(20).fontWeight(FontWeight.Bold)
          .margin({ left: 16 })
      }
      .width('100%')
      .padding({ left: 16, right: 16, top: 16, bottom: 16 })

      // æˆå‘˜åˆ—è¡¨
      List() {
        ForEach(this.members, (member: FamilyProfile) => {
          ListItem() {
            this.MemberListItem(member)
          }
        }, (member: FamilyProfile) => member.memberId)

        // æ·»åŠ æˆå‘˜æŒ‰é’®
        ListItem() {
          Row() {
            Text('+ æ·»åŠ å®¶åº­æˆå‘˜').fontSize(16).fontColor('#1976D2')
          }
          .width('100%')
          .height(56)
          .justifyContent(FlexAlign.Center)
          .backgroundColor('#E3F2FD')
          .borderRadius(12)
          .margin({ top: 8 })
          .onClick(() => {
            router.pushUrl({ url: 'pages/MemberEditPage' })
          })
        }
      }
      .width('100%')
      .layoutWeight(1)
      .padding({ left: 16, right: 16 })
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#FAFAFA')
  }

  @Builder
  MemberListItem(member: FamilyProfile) {
    Row() {
      Column() {
        Text(member.nickname).fontSize(16).fontWeight(FontWeight.Medium)
        Text(member.healthGoals.join('Â·')).fontSize(12).fontColor('#757575').margin({ top: 4 })
      }
      .alignItems(HorizontalAlign.Start)
      .layoutWeight(1)

      Text('ç¼–è¾‘').fontSize(14).fontColor('#1976D2')
    }
    .width('100%')
    .padding(16)
    .backgroundColor('#FFFFFF')
    .borderRadius(12)
    .margin({ top: 8 })
    .onClick(() => {
      router.pushUrl({
        url: 'pages/MemberEditPage',
        params: { memberId: member.memberId }
      })
    })
  }
}
