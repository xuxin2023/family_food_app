            Button('åˆ·æ–°æ–‡æ¡ˆ')
              .layoutWeight(1)
              .height(44)
              .backgroundColor('#E3F2FD')
              .fontColor('#1976D2')
              .borderRadius(22)
              .onClick(() => { this.refreshShareText() })

            Button('å¤åˆ¶è¯´æ˜')
