export class KnowledgeArticle {
  id: string = '';
  category: string = '';
  title: string = '';
  summary: string = '';
  content: string = '';
  tags: string[] = [];
}

function makeArticle(
  id: string, category: string, title: string, summary: string, content: string, tags: string[]
): KnowledgeArticle {
  const a = new KnowledgeArticle();
  a.id = id;
  a.category = category;
  a.title = title;
  a.summary = summary;
  a.content = content;
  a.tags = tags;
  return a;
}

