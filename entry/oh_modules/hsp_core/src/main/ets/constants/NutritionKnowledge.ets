    '- 食欲下降：少食多餐，增加食物风味（非增加盐）\n' +
    '- 咀嚼困难：选择软烂食物，蒸煮为主\n' +
    '- 便秘：增加膳食纤维和水分摄入\n' +
    '- 药物影响：某些药物影响食欲或营养吸收\n\n' +
    '饮食建议：\n' +
    '- 每餐有优质蛋白：鱼、蛋、奶、豆制品\n' +
    '- 每天2-3杯奶制品（钙+蛋白质）\n' +
    '- 充足蔬菜水果（维生素+纤维）\n' +
    '- 适度户外活动（维生素D+防肌少）\n' +
    '- 控盐<5g/天，但不必过度限盐导致低钠',
    ['老年', '肌少症', '钙', '骨质疏松']
  ));

  return articles;
}

export function getArticleCategories(): string[] {
  return ['营养素解读', '标签解读', '饮食误区', '特殊人群饮食'];
}

export function getArticlesByCategory(category: string): KnowledgeArticle[] {
  const all = getAllKnowledgeArticles();
  const result: KnowledgeArticle[] = [];
  for (let i = 0; i < all.length; i++) {
    if (all[i].category === category) {
      result.push(all[i]);
    }
  }
  return result;
}
