{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "privacyPolicyUrl": "https://foodscan.familyfood.app/privacy",
    "userAgreementUrl": "https://foodscan.familyfood.app/agreement",
    "debug": false,
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:ability_desc",
        "icon": "$media:app_icon",
        "label": "$string:ability_label",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "continuable": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          },
          {
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "https",
                "host": "foodscan.familyfood.app"
              }
            ]
          }
        ]
      },
      {
        "name": "ScanDirectAbility",
        "srcEntry": "./ets/scanability/ScanDirectAbility.ets",
        "description": "$string:ability_desc",
        "icon": "$media:app_icon",
        "label": "$string:ability_label",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "actions": [
              "action.system.scan"
            ]
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.CAMERA",
        "reason": "$string:camera_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility",
            "ScanDirectAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.INTERNET",
        "reason": "$string:internet_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO",
        "reason": "$string:internet_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.VIBRATE",
        "reason": "$string:vibrate_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.PUBLISH_AGENT_REMINDER",
        "reason": "$string:reminder_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "always"
        }
      },
      {
        "name": "ohos.permission.READ_IMAGEVIDEO",
        "reason": "$string:media_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.WRITE_IMAGEVIDEO",
        "reason": "$string:media_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.READ_HEALTH_DATA",
        "reason": "$string:read_health_data_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.ACTIVITY_MOTION",
        "reason": "$string:activity_motion_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.DISTRIBUTED_DATASYNC",
        "reason": "$string:distributed_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      }
    ],
    "dataSecurity": {
      "personalDataCollection": [
        {
          "dataType": "家庭成员信息（昵称、年龄、性别）",
          "purpose": "个性化营养推荐",
          "storage": "本地数据库，不出境"
        },
        {
          "dataType": "健康状态（步数、睡眠、血压等）",
          "purpose": "健康适配计算",
          "storage": "本地数据库加密存储，不出境"
        },
        {
          "dataType": "过敏原与饮食偏好",
          "purpose": "过敏预警与食品推荐",
          "storage": "本地数据库，不出境"
        },
        {
          "dataType": "食品扫描记录与营养数据",
          "purpose": "历史记录与统计分析",
          "storage": "本地数据库，不出境"
        },
        {
          "dataType": "相机/相册图片",
          "purpose": "食品标签OCR识别",
          "storage": "仅在内存中临时处理，不持久存储"
        },
        {
          "dataType": "设备唯一标识(UID)",
          "purpose": "匿名身份识别",
          "storage": "本地偏好存储，不出境"
        }
      ],
      "dataStorage": {
        "localEncryption": true,
        "cloudSyncOptional": true,
        "cloudRegion": "cn-north-4",
        "dataRetention": "用户主动删除前持续保留，卸载应用后本地数据清除"
      },
      "dataSharing": {
        "thirdPartySharing": false,
        "crossBorderTransfer": false,
        "sdkList": [
          {
            "name": "华为 Scan Kit",
            "purpose": "条码/二维码扫描",
            "dataHandling": "数据不离开设备"
          },
          {
            "name": "华为 Health Kit",
            "purpose": "读取健康数据",
            "dataHandling": "数据不离开设备"
          },
          {
            "name": "华为云 Serverless",
            "purpose": "云函数/云数据库/云存储",
            "dataHandling": "服务器位于中国大陆(cn-north-4)"
          },
          {
            "name": "Open Food Facts API",
            "purpose": "条码查询开放数据库",
            "dataHandling": "仅发送条码编号，服务器位于欧洲"
          }
        ]
      }
    },
    "extensionAbilities": [
      {
        "name": "EntryFormAbility",
        "srcEntry": "./ets/entryformability/EntryFormAbility.ets",
        "label": "$string:app_name",
        "description": "$string:form_desc",
        "type": "form",
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      }
    ]
  }
}
