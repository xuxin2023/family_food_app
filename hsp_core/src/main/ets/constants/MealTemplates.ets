export class MealTemplate {
  scenario: string = '';
  riskTags: string[] = [];
  nextMealAdvice: string = '';
  avoidStacking: string[] = [];
  hydrationReminder: boolean = false;
  morningAdvice: string = '';
  nextMealNutrients: string[] = [];
  goalAdvice: Map<string, string> = new Map();
}

function makeMealTemplate(
  scenario: string, riskTags: string[], nextMealAdvice: string,
  avoidStacking: string[], hydrationReminder: boolean, morningAdvice: string,
  nextMealNutrients: string[], goalAdvice: Map<string, string>
): MealTemplate {
  const t = new MealTemplate();
  t.scenario = scenario;
  t.riskTags = riskTags;
  t.nextMealAdvice = nextMealAdvice;
  t.avoidStacking = avoidStacking;
  t.hydrationReminder = hydrationReminder;
  t.morningAdvice = morningAdvice;
  t.nextMealNutrients = nextMealNutrients;
  t.goalAdvice = goalAdvice;
  return t;
}

