// TcmFoodProperty.ets
// 中医食物性味模型 — 寒热温凉平 + 酸苦甘辛咸 + 归经

export enum TcmNature {
  COLD = '寒',
  COOL = '凉',
  NEUTRAL = '平',
  WARM = '温',
  HOT = '热'
}

export enum TcmFlavor {
  SOUR = '酸',
  BITTER = '苦',
  SWEET = '甘',
  PUNGENT = '辛',
  SALTY = '咸'
}

export enum TcmConstitution {
  QI_DEFICIENCY = '气虚质',
  YIN_DEFICIENCY = '阴虚质',
  YANG_DEFICIENCY = '阳虚质',
  PHLEGM_DAMP = '痰湿质',
  DAMP_HEAT = '湿热质',
  BLOOD_STASIS = '血瘀质',
  QI_STAGNATION = '气郁质',
  SPECIAL_DIATHESIS = '特禀质',
  BALANCED = '平和质'
}

export class TcmFoodEntry {
  foodName: string = '';
  nature: TcmNature = TcmNature.NEUTRAL;
  flavors: TcmFlavor[] = [];
  meridians: string[] = [];
  effects: string = '';
  suitableFor: TcmConstitution[] = [];
  avoidFor: TcmConstitution[] = [];
  category: string = '';
}

export class TcmMatchResult {
  food: TcmFoodEntry = new TcmFoodEntry();
  isSuitable: boolean = false;
  isAvoid: boolean = false;
  reason: string = '';
}

export class TcmFoodDatabase {
  private entries: TcmFoodEntry[] = [];
  private nameIndex: Map<string, TcmFoodEntry> = new Map();

  constructor() {
    this.entries = buildDatabase();
    for (let i = 0; i < this.entries.length; i++) {
      this.nameIndex.set(this.entries[i].foodName, this.entries[i]);
    }
  }

  lookup(foodName: string): TcmFoodEntry | null {
    const lower = foodName.toLowerCase();
    for (const key of this.nameIndex.keys()) {
      if (lower.includes(key) || key.includes(lower)) {
        return this.nameIndex.get(key) ?? null;
      }
    }
    return null;
  }

  matchConstitution(foodName: string, constitution: TcmConstitution): TcmMatchResult | null {
    const entry = this.lookup(foodName);
    if (entry === null) return null;

    const result: TcmMatchResult = new TcmMatchResult();
    result.food = entry;

    if (entry.suitableFor.includes(constitution)) {
      result.isSuitable = true;
      result.reason = entry.foodName + '性' + entry.nature + '，适合' + constitution + '体质';
    } else if (entry.avoidFor.includes(constitution)) {
      result.isAvoid = true;
      result.reason = entry.foodName + '性' + entry.nature + '，' + constitution + '体质不宜';
    } else {
      result.reason = entry.foodName + '性' + entry.nature + '，' + entry.flavors.join('') + '味，归' + entry.meridians.join('、') + '经';
    }
    return result;
  }

  getAllEntries(): TcmFoodEntry[] {
    return this.entries;
  }
}

function parseNature(s: string): TcmNature {
  if (s === '寒') return TcmNature.COLD;
  if (s === '凉') return TcmNature.COOL;
  if (s === '平') return TcmNature.NEUTRAL;
  if (s === '温') return TcmNature.WARM;
  if (s === '热') return TcmNature.HOT;
  return TcmNature.NEUTRAL;
}

function parseFlavors(s: string): TcmFlavor[] {
  const result: TcmFlavor[] = [];
  const parts = s.split(',');
  for (let i = 0; i < parts.length; i++) {
    const p = parts[i].trim();
    if (p === '酸') result.push(TcmFlavor.SOUR);
    else if (p === '苦') result.push(TcmFlavor.BITTER);
    else if (p === '甘') result.push(TcmFlavor.SWEET);
    else if (p === '辛') result.push(TcmFlavor.PUNGENT);
    else if (p === '咸') result.push(TcmFlavor.SALTY);
  }
  return result;
}

function parseConstitutions(s: string): TcmConstitution[] {
  if (s.length === 0) return [];
  const result: TcmConstitution[] = [];
  const parts = s.split(',');
  for (let i = 0; i < parts.length; i++) {
    const p = parts[i].trim();
    if (p === '气虚质') result.push(TcmConstitution.QI_DEFICIENCY);
    else if (p === '阴虚质') result.push(TcmConstitution.YIN_DEFICIENCY);
    else if (p === '阳虚质') result.push(TcmConstitution.YANG_DEFICIENCY);
    else if (p === '痰湿质') result.push(TcmConstitution.PHLEGM_DAMP);
    else if (p === '湿热质') result.push(TcmConstitution.DAMP_HEAT);
    else if (p === '血瘀质') result.push(TcmConstitution.BLOOD_STASIS);
    else if (p === '气郁质') result.push(TcmConstitution.QI_STAGNATION);
    else if (p === '特禀质') result.push(TcmConstitution.SPECIAL_DIATHESIS);
    else if (p === '平和质') result.push(TcmConstitution.BALANCED);
  }
  return result;
}

