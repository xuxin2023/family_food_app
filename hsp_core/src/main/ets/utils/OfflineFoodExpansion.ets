// OfflineFoodExpansion.ets
// 离线食品数据库扩充 — 按品类系统性添加国产常见食品
// 目标: 将离线库从30条扩充至500+条

import { OfflineFoodEntry } from '../model/IOfflineFoodProvider';

function mk(
  barcode: string, foodName: string, manufacturer: string, category: string,
  calories: number, fat: number, saturatedFat: number,
  carbohydrate: number, sugar: number, protein: number, sodium: number,
  fiber: number, ingredients: string[], allergenHints: string[]
): OfflineFoodEntry {
  const e: OfflineFoodEntry = new OfflineFoodEntry();
  e.barcode = barcode;
  e.foodName = foodName;
  e.manufacturer = manufacturer;
  e.category = category;
  e.nutrition.calories = calories;
  e.nutrition.fat = fat;
  e.nutrition.saturatedFat = saturatedFat;
  e.nutrition.carbohydrate = carbohydrate;
  e.nutrition.sugar = sugar;
  e.nutrition.protein = protein;
  e.nutrition.sodium = sodium;
  e.nutrition.fiber = fiber;
  e.ingredients = ingredients;
  e.allergenHints = allergenHints;
  return e;
}

